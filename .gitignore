# Virtualenv and Python build noise
.venv/
__pycache__/

# macOS filesystem litter
.DS_Store

# Generated blog output is local working product, not source: dossiers, drafts,
# evals, and status feeds are reproducible from the roadmap and the pipeline,
# and reviewed copy ships through the CMS, never through this repo. Operators
# prune these folders in Finder, and the app treats the filesystem as the truth.
outputs/

# Graphify knowledge-graph output is generated tooling product, not source: `/graphify`
# rebuilds it from the tree on demand and it runs to several MB of HTML and JSON. Same rule
# as outputs/ above, for the same reason: reproducible local working product, not source.
graphify-out/

# Client config and content is materialized from the Supabase record by
# sync.materialize_client (see server/clients.py): regenerable scratch keyed off the
# database, NOT source, exactly like outputs/ and graphify-out/ above. Ignore every
# client folder by default so real client data can never land in git or a release
# zip by reflex, and allow-list ONLY the test fixtures the suite reads from disk. A
# new real client is auto-excluded; it lives in the DB and materialize rebuilds it.
clients/*/
!clients/_fixture-unreviewed/

# Uploaded roadmaps are the operator's own input; never tracked, even under a fixture.
clients/*/uploads/

# Secrets. Every credential reaches this app through the environment, never a
# file in the tree: .mcp.json interpolates ${VAR} and is safe to commit, an
# .env would not be. There is no .env here today, and this rule is what keeps
# a future one from being committed by reflex.
.env
.env.*
!.env.example

# Node build artefacts. dashboard/.gitignore already covers its own subtree;
# these unanchored rules catch a package directory added anywhere else later.
node_modules/
.next/

# The starter install.sh generates. It hardcodes absolute paths to THIS machine's
# tree and bundled runtimes, so committing one would hand every other teammate a
# launcher pointing at a directory they do not have. The checked-in
# "Start Canon.command" stays: it is machine-independent because it defers to
# whatever python3 is on PATH.
Start Canon (installed).command

# Packaged skill zips are built from .claude/skills/<name>/; the folder is the source.
*.skill
