# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is the one env file that carries NAMES and no values. It was
# swept up by .env* above, so it never reached the repository and anyone importing the project
# had no record of which variables to set. Keeping it tracked is the point of having it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
