# Server-side env for the HOSTED (read-only) deployment's Route Handlers. Local dev against
# the FastAPI engine needs none of these; see README-VERCEL.md for the two-mode story.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co (no trailing slash).
SUPABASE_URL=https://your-project-ref.supabase.co

# The project's ANON (publishable) key. Server-side only here; the SECRET key is never used
# anywhere in this dashboard.
SUPABASE_ANON_KEY=your-anon-key

# Set to true on the hosted deployment: hides every control that needs the live engine and
# keeps API_BASE at "" (same origin) so fetches hit the /api Route Handlers.
NEXT_PUBLIC_HOSTED_READONLY=true

# Deliberately UNSET on the hosted deployment (same-origin routes answer instead). For local
# dev against the engine, either leave it unset (development defaults to localhost:8000) or
# point it at the engine explicitly:
# NEXT_PUBLIC_API_BASE=http://localhost:8000
